{
	"name": "scheman",
	"private": true,
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "bun run --filter '*' build:dist",
		"typecheck": "bun run --filter '*' build",
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"version-packages": "changeset version && biome format --write packages/*/package.json"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/cli": "^2.27.0",
		"tsup": "^8.3.0",
		"typescript": "^5.7.0",
		"vitest": "^3.1.0",
		"zod3": "npm:zod@3.25.76",
		"zod3-min": "npm:zod@3.24.0",
		"zod4": "npm:zod@4.1.5",
		"zod4-min": "npm:zod@4.0.0"
	},
	"packageManager": "bun@1.2.0"
}
