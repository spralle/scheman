{
	"name": "@scheman/core",
	"version": "0.1.0",
	"type": "module",
	"description": "Universal schema ingestion and metadata extraction for JSON Schema, Zod v3, and Zod v4",
	"keywords": ["schema", "json-schema", "zod", "metadata", "extraction", "standard-schema", "ingestion"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/spralle/scheman.git",
		"directory": "packages/core"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["dist", "src"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit",
		"build:dist": "tsup",
		"test": "vitest run"
	},
	"dependencies": {},
	"peerDependencies": {
		"zod": ">=3.24.0 <4 || >=4.0.0 <5"
	},
	"peerDependenciesMeta": {
		"zod": { "optional": true }
	}
}
