{
  "name": "@scheman/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Universal schema ingestion and metadata extraction for JSON Schema, Zod v3, and Zod v4",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit",
    "build:dist": "tsup",
    "test": "vitest run"
  },
  "dependencies": {},
  "peerDependencies": {
    "zod": ">=3.0.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true }
  }
}
