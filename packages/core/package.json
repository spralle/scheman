{
	"name": "@scheman/core",
	"version": "1.0.0",
	"type": "module",
	"description": "Universal schema ingestion and metadata extraction for JSON Schema, Zod v3, and Zod v4",
	"keywords": ["schema", "json-schema", "zod", "metadata", "extraction", "standard-schema", "ingestion"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/spralle/scheman.git",
		"directory": "packages/core"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
			"require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
		}
	},
	"files": ["dist", "src", "README.md", "MIGRATION.md"],
	"sideEffects": false,
	"scripts": {
		"build": "tsc --noEmit && tsc -p tsconfig.document-tests.json",
		"build:dist": "node ../../scripts/prepare-package-docs.mjs && tsup",
		"test": "vitest run"
	},
	"dependencies": {
		"@standard-schema/spec": "1.1.0"
	},
	"peerDependencies": {
		"zod": ">=3.24.0 <4 || >=4.0.0 <5"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	}
}
